{
  "name": "analog-metadata",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Capture handwritten analog film-log metadata and bridge it into digital scans (Lightroom, Capture One, Explorer/Finder). iOS, Android, Windows and macOS from one codebase.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "piexifjs": "^1.0.6",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
